{
  "name": "@nova-component/design-tokens",
  "version": "0.1.0",
  "description": "Shared semantic design tokens for the Nova product family.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nejo12/nova-ui.git",
    "directory": "packages/design-tokens"
  },
  "homepage": "https://github.com/Nejo12/nova-ui#readme",
  "keywords": [
    "nova",
    "design-system",
    "design-tokens",
    "css-variables"
  ],
  "scripts": {
    "build": "node ../../tooling/token-build/build.mjs && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "lint": "eslint src --max-warnings=0",
    "lint:styles": "stylelint 'dist/**/*.css' --allow-empty-input",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@nova/eslint-config": "workspace:*",
    "@nova/stylelint-config": "workspace:*",
    "eslint": "^10.0.0",
    "stylelint": "^17.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
