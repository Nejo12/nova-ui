{
  "name": "@nova/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css", "**/*.scss"],
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nova-ui.js"
    },
    "./styles.css": "./dist/nova-ui.css"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "dependencies": {
    "@nova/design-tokens": "workspace:*"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint src .storybook --max-warnings=0",
    "lint:styles": "stylelint 'src/**/*.{css,scss}' --allow-empty-input",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@nova/eslint-config": "workspace:*",
    "@nova/stylelint-config": "workspace:*",
    "@storybook/addon-a11y": "^9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.10.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.90.0",
    "storybook": "^9.1.5",
    "stylelint": "^17.15.0",
    "typescript": "~6.0.3",
    "vite": "^7.1.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^5.0.0"
  }
}
