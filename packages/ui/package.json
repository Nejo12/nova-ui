{
  "name": "@nova-component/ui",
  "version": "0.2.0",
  "description": "Shared React UI primitives for the Nova product family.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/nova-ui.js"
    },
    "./styles.css": "./dist/nova-ui.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nejo12/nova-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/Nejo12/nova-ui#readme",
  "keywords": [
    "nova",
    "react",
    "design-system",
    "ui-components",
    "accessibility"
  ],
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "dependencies": {
    "@nova-component/design-tokens": "workspace:*"
  },
  "scripts": {
    "build": "vite build -c vite.lib.config.ts && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "dev": "pnpm --filter @nova-component/design-tokens build && storybook dev -p 6006",
    "storybook": "pnpm --filter @nova-component/design-tokens build && storybook dev -p 6006",
    "build-storybook": "pnpm --filter @nova-component/design-tokens build && storybook build",
    "lint": "eslint src .storybook --max-warnings=0",
    "lint:styles": "stylelint 'src/**/*.{css,scss}' --allow-empty-input",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@nova/eslint-config": "workspace:*",
    "@nova/stylelint-config": "workspace:*",
    "@storybook/addon-a11y": "^9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.90.0",
    "storybook": "^9.1.5",
    "stylelint": "^17.15.0",
    "typescript": "~6.0.3",
    "vite": "^7.1.3",
    "vitest": "^5.0.0"
  }
}
