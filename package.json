{
  "name": "nova-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"**/*.{css,scss}\" --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/storybook-static/**\" --ignore-pattern \"**/coverage/**\" --allow-empty-input",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "tokens:verify": "pnpm --filter @nova-component/design-tokens build && git diff --exit-code -- packages/design-tokens/dist/tokens.css packages/design-tokens/dist/tokens.json",
    "package:verify": "node tooling/package-verify/verify.mjs",
    "storybook": "pnpm --filter @nova-component/ui storybook",
    "storybook:build": "pnpm --filter @nova-component/ui build-storybook",
    "changeset": "changeset",
    "release:status": "changeset status --since=main",
    "release:version": "changeset version",
    "check": "pnpm docs:verify && pnpm format:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm test && pnpm build && pnpm tokens:verify && pnpm package:verify && pnpm storybook:build",
    "docs:generate": "node tooling/component-index/generate.mjs",
    "docs:verify": "node tooling/component-index/generate.mjs --check",
    "test:browser": "playwright test -c tooling/browser-a11y/playwright.config.ts",
    "typecheck:browser": "tsc -p tooling/browser-a11y/tsconfig.json && pnpm --filter @nova-component/ui exec tsc -p browser-a11y/tsconfig.json",
    "consumers:verify": "node tooling/package-verify/verify.mjs --consumers"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@nova/eslint-config": "workspace:*",
    "@nova/stylelint-config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "eslint": "^10.12.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3"
  }
}
