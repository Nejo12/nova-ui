{
  "name": "nova-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"**/*.{css,scss}\" --ignore-pattern \"**/dist/**\" --ignore-pattern \"**/storybook-static/**\" --allow-empty-input",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "tokens:verify": "pnpm --filter @nova-component/design-tokens build && git diff --exit-code -- packages/design-tokens/dist/tokens.css packages/design-tokens/dist/tokens.json",
    "storybook": "pnpm --filter @nova-component/ui storybook",
    "storybook:build": "pnpm --filter @nova-component/ui build-storybook",
    "changeset": "changeset",
    "release:status": "changeset status --since=main",
    "release:version": "changeset version",
    "check": "pnpm format:check && pnpm lint && pnpm lint:styles && pnpm typecheck && pnpm test && pnpm build && pnpm tokens:verify && pnpm storybook:build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.2",
    "@nova/eslint-config": "workspace:*",
    "@nova/stylelint-config": "workspace:*",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3"
  }
}
